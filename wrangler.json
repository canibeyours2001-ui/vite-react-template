{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vite-react-template",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "MEMORY_DB",
      "database_name": "hono-telegram-memory",
      "database_id": "6ce17b28-cdcb-4e89-a011-1748e736e43c"
    }
  ],
  "vars": {
    "MODAL_WAN_API_BASE": "https://canibeyours2001-ui--wan22-ti2v-5b-web-api.modal.run",
    "MODAL_MOTION_API_BASE": "https://canibeyours2001-ui--wan22-animate-telegram-web-api.us-east.modal.run"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
